# Copy this to .env on the origin machine.

ORIGIN_IMAGE=netcdn/origin-server:cachefix-20260413
ORIGIN_HOST_PORT=4000

MONGO_URI=mongodb://mongo:27017/origin_db

# Edge purge fan-out
EDGE_PURGE_PORT=3002
EDGE_DOCKER_LOOPBACK_HOST=host.docker.internal
EDGE_INDIA_URL=http://edge-india.local:3002
EDGE_CHINA_URL=http://edge-china.local:3002
EDGE_RUSSIA_URL=http://edge-russia.local:3002
EDGE_PURGE_ENDPOINTS=http://edge-india.local:3002,http://edge-china.local:3002,http://edge-russia.local:3002
